# Copy to .env.local and fill in. Never commit .env.local.

# Local: `pnpm db:dev` runs a replica set on 27017. Production: your Atlas SRV string.
MONGODB_URI="mongodb://127.0.0.1:27017/?replicaSet=rs0"
MONGODB_DB="qr_feed"

# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails allowed into /super
SUPER_ADMIN_EMAILS=""

# "off" only for automated tests
AUTH_RATE_LIMIT="on"

# Public feedback form: rate limits ("off" only for automated tests)
INTAKE_RATE_LIMIT="on"
# Cloudflare Turnstile bot check on the public form. Leave both empty to disable.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Object storage: works with Cloudflare R2 or AWS S3. Leave empty for local `.data/uploads/`.
# R2 example: STORAGE_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com", STORAGE_REGION="auto"
# S3 example: STORAGE_REGION="ap-south-1" (endpoint optional)
STORAGE_ENDPOINT=""
STORAGE_REGION="auto"
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""

# Notifications: Resend email & Twilio SMS/WhatsApp. Logs to console in dev when unset.
# Resend: create a key at resend.com/api-keys (starts with re_). MAIL_FROM must use a domain
# verified at resend.com/domains; until then only "onboarding@resend.dev" works, and only to
# your own Resend account email. Rejected sends are logged as "[mail] Resend rejected …".
RESEND_API_KEY=""
MAIL_FROM="QR Feed <notifications@qrfeed.local>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""
TWILIO_WHATSAPP_FROM=""

# Background SLA worker & cron endpoint
REDIS_URL=""
CRON_SECRET=""

# Billing webhooks (Stripe or Razorpay; sandbox mode when unset)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
