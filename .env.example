# Copy to .env.local and fill in. Never commit .env.local.

# Local: `pnpm db:dev` runs a replica set on 27017. Production: your Atlas SRV string.
MONGODB_URI="mongodb://127.0.0.1:27017/?replicaSet=rs0"
MONGODB_DB="qr_feed"

# openssl rand -base64 32
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated emails allowed into /super
SUPER_ADMIN_EMAILS=""

# "off" only for automated tests
AUTH_RATE_LIMIT="on"

# Public feedback form: rate limits ("off" only for automated tests)
INTAKE_RATE_LIMIT="on"
# Cloudflare Turnstile bot check on the public form. Leave both empty to disable.
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
